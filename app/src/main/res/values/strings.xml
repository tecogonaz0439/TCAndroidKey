    <!-- About -->
    <string name="about_description">A testing tool for FIDO / FIDO2 (WebAuthn) web applications: turns this Android device into a FIDO2 (CTAP2) security key over NFC. Do not use it as a replacement for physical security keys such as YubiKey, and do not register it with production accounts. No Google Play services required.</string>
    <string name="about_version">Version</string>
    <string name="about_aaguid">AAGUID</string>
    <string name="about_protocols">Protocols</string>
    <string name="about_protocols_value" tools:ignore="TypographyDashes">CTAP 2.0 (FIDO_2_0) over NFC (ISO 7816-4 / HCE), CTAPHID over Bluetooth HID (experimental)</string>
    <string name="about_algorithms">Algorithms</string>
    <string name="about_security">Security</string>
    <string name="about_security_text">Private keys are generated in the Android Keystore (StrongBox or TEE) and cannot be exported. Each key can be used only for a limited time after user verification, only while the device is unlocked, and only while this app is in the foreground.</string>
